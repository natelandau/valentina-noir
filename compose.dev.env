# Non-secret defaults for the API container in local dev stacks. compose.yml sets the
# connection values; .dev/generated.env holds the encryption keys; .env.local overrides both.

VAPI_NAME=valentina-noir-dev
VAPI_DEBUG=true

VAPI_LOG__FILE_PATH=/app/.dev/logs/app.log

VAPI_STORES__TTL=120

VAPI_OAUTH__APPLE_AUDIENCES=org.natelandau.valentina-app,org.natelandau.valentina-web
VAPI_OAUTH__GOOGLE_AUDIENCES=726307775784-1i4btrb1gnrah697e5lrau6trhg19icp.apps.googleusercontent.com

VAPI_RATE_LIMIT__ALLOW_IGNORE_HEADER=true

VAPI_RATE_LIMIT__POLICIES__0__NAME=hourly
VAPI_RATE_LIMIT__POLICIES__0__CAPACITY=1000
VAPI_RATE_LIMIT__POLICIES__0__REFILL_RATE=0.28
VAPI_RATE_LIMIT__POLICIES__0__SET_HEADERS=true
VAPI_RATE_LIMIT__POLICIES__0__SET_429_HEADERS=true

VAPI_RATE_LIMIT__POLICIES__1__NAME=burst
VAPI_RATE_LIMIT__POLICIES__1__CAPACITY=60
VAPI_RATE_LIMIT__POLICIES__1__REFILL_RATE=1
VAPI_RATE_LIMIT__POLICIES__1__SET_HEADERS=true
VAPI_RATE_LIMIT__POLICIES__1__SET_429_HEADERS=true
